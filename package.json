{
  "name": "hot-pot-go",
  "productName": "Hot Pot Go",
  "version": "0.1.0",
  "description": "Hot Pot Go – a chef in a slightly odd restaurant",
  "author": "Marija",
  "private": true,
  "main": "main.js",
  "scripts": {
    "vendor": "node scripts/copy-vendor.js",
    "start": "electron .",
    "dist": "electron-builder --win dir"
  },
  "build": {
    "appId": "com.hotpotgo.game",
    "productName": "Hot Pot Go",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "decor.js",
      "models/**/*",
      "textures/**/*",
      "vendor/**/*"
    ],
    "asar": true,
    "electronLanguages": [
      "de",
      "en-US"
    ],
    "win": {
      "target": "dir"
    }
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "three": "^0.128.0"
  }
}
